# --- Supabase project identity ---
# NOT currently read by any application code — Better Auth (lib/auth.ts)
# and Drizzle (lib/db/index.ts) both connect via DATABASE_URL directly, not
# the Supabase client SDK. These are provided for forward-compatibility
# with the linked Supabase project and any future Supabase-specific
# tooling; adding them here does not change how the app connects today.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# Base public URL of the deployed app, used to build the absolute link
# encoded in each receipt's verification QR code. Optional — if unset,
# falls back to BETTER_AUTH_URL, then to the incoming request's own host.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL connection string used by both Drizzle and Better Auth (the
# same shared pool — see lib/db/index.ts and lib/auth.ts).
#
# If using Supabase: use the "Session" pooler connection string (port 5432
# on the pooler host) or the direct connection string, NOT the
# "Transaction" pooler (port 6543) — this app keeps one long-lived pg.Pool
# and uses a session/transaction advisory lock in app/actions/bootstrap.ts
# (pg_advisory_xact_lock) for the first-run admin setup. Transaction-mode
# pooling (Supavisor/PgBouncer in transaction mode) can hand out a
# different underlying server connection per transaction, which is not
# guaranteed to interact correctly with a persistent application-level Pool
# sized for direct connections, and some poolers in that mode don't support
# session-level features some drivers rely on. Session pooling / direct
# connection avoids this entirely and is the safer default for this app's
# connection pattern. Find this in the Supabase dashboard under
# Project Settings → Database → Connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/swuws"

# Base URL Better Auth uses to build callback/cookie URLs. Required in
# production on any host other than Vercel (see lib/auth.ts) — without it,
# and without VERCEL_URL/VERCEL_PROJECT_PRODUCTION_URL, auth cookies and
# origin checks can silently misbehave.
BETTER_AUTH_URL="http://localhost:3000"

# Secret used by Better Auth to sign sessions/tokens. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-real-random-secret"

# Comma-separated list of additional origins allowed to call the auth API,
# beyond the Vercel-derived ones already handled automatically. Required for
# any non-Vercel deployment (audit finding 9.7).
BETTER_AUTH_TRUSTED_ORIGINS="https://receipts.swuws.example"

# Vercel Blob token, used for org logo and receipt attachment uploads.
BLOB_READ_WRITE_TOKEN="replace-with-a-real-vercel-blob-token"

# --- Android app backend URL (capacitor.config.ts) ---
# Which backend the Android app (public/swuws-portal.apk) talks to. Only
# read when someone runs `npx cap sync android` to rebuild the app — has
# no effect on the web app itself. Update this and rebuild whenever the
# production domain changes, instead of editing capacitor.config.ts directly.
CAPACITOR_SERVER_URL="https://swuws-receipts-app-q2z9.vercel.app"

# --- Transactional email (lib/email-service.ts) ---
# Required for password-reset emails to actually be delivered. Without this,
# in development the email content is logged to the server console instead
# (intended, for local testing); in production, sending fails loudly (an
# error is returned to the UI) rather than silently pretending to succeed.
# Get a key at https://resend.com — requires a verified sending domain.
RESEND_API_KEY="re-place-with-a-real-resend-key"
# Optional. "Display Name <verified@yourdomain>" — defaults to
# "SWUWS Portal <noreply@receipts.swuws.org>" if unset.
RESEND_FROM_ADDRESS="SWUWS Portal <noreply@receipts.swuws.org>"

# --- SMS gateway (lib/sms-service.ts) ---
# Used for billing/collection SMS notifications to customers. Not required —
# if unset, sendSMS() logs the message and audit-trails it as "simulated"
# instead of failing, so billing runs are never blocked by a missing SMS
# provider. Set these three when a provider is available (e.g. Africa's
# Talking, common for Uganda) and SMS will start sending for real with no
# code changes required.
SMS_PROVIDER="africastalking"
SMS_API_KEY=""
SMS_USERNAME=""
SMS_SENDER_ID=""
