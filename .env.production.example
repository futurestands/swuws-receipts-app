# SWUWS Production Environment Configuration Template

# 1. Database (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:pass@host:5432/db"

# 2. Authentication (Better Auth)
# Generate a secure 32-character string
BETTER_AUTH_SECRET="your-32-char-secret-here"
# The public URL of your live application
BETTER_AUTH_URL="https://receipts.swuws.co.ug"

# 3. Storage (Vercel Blob)
# Required for logo uploads and official document storage
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token-here"

# 4. Environment Flags
NODE_ENV="production"
PORT=3000

# 5. Application Branding (Defaults)
NEXT_PUBLIC_ORG_NAME="South Western Umbrella of Water and Sanitation"
