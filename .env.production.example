# SWUWS Production Environment Configuration Template

# 1. Base URL Configuration
# The canonical URL of your live application (e.g., https://receipts.swuws.co.ug)
# This is critical for both the web app and the mobile (Capacitor) build.
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# 2. Database (PostgreSQL)
# PRODUCTION ENFORCEMENT: Always append ?sslmode=require to your connection string.
DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"

# 3. Authentication (Better Auth)
# Generate a secure 32-character string for BETTER_AUTH_SECRET
BETTER_AUTH_SECRET="your-32-char-secret-here"
BETTER_AUTH_URL="https://your-domain.com"
# List of authorized origins for authentication (comma-separated)
BETTER_AUTH_TRUSTED_ORIGINS="https://your-domain.com"

# 4. Storage (Vercel Blob)
# Required for official document and logo storage.
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token-here"

# 5. Environment Flags
NODE_ENV="production"
PORT=3000

# 6. Application Branding
NEXT_PUBLIC_ORG_NAME="South Western Umbrella of Water and Sanitation"
